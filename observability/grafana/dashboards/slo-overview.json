    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Restart / deploy",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "enable": true,
        "iconColor": "orange",
        "expr": "changes(process_start_time_seconds{service=\"$service\"}[$__rate_interval]) > 0",
        "step": "1m",
        "titleFormat": "Restart",
        "textFormat": "{{instance}} reiniciou (process_start_time_seconds mudou)",
        "tagKeys": "service,instance"
      },
      {
        "name": "Alertas firing",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "ALERTS{alertstate=\"firing\",service=\"$service\"}",
        "step": "1m",
        "titleFormat": "{{alertname}}",
        "textFormat": "severity={{severity}}",
        "tagKeys": "alertname,severity"
      }
    ]
  },
