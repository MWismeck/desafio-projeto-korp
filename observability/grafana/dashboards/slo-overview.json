        "current": {
          "selected": true,
          "text": "http-server-projeto-korp",
          "value": "http-server-projeto-korp"
        },
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "sort": 1,
        "options": []
      }
    ]
  },
