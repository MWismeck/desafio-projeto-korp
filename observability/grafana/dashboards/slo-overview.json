    {
      "type": "timeseries",
      "id": 10,
      "title": "Burn rate interno",
      "description": "Quantas vezes mais rápido que o permitido o orçamento está sendo consumido: (1 − SLI) / 0.001. Não existe recording rule interna de burn — os alertas calculam a expressão inline —, então o painel repete a mesma conta, nas mesmas janelas. Acima de 14,4 na janela de 1 h o orçamento de 30 dias acaba em 2 dias: é page. Acima de 6 na de 6 h, page. Acima de 1 na de 3 d, ticket.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(1 - service:sli_availability:ratio_rate1h{service=\"$service\"}) / 0.001",
          "legendFormat": "1h (page em 14,4)"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(1 - service:sli_availability:ratio_rate6h{service=\"$service\"}) / 0.001",
          "legendFormat": "6h (page em 6)"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(1 - service:sli_availability:ratio_rate3d{service=\"$service\"}) / 0.001",
          "legendFormat": "3d (ticket em 1)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
