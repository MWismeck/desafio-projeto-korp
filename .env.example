# .env.example — chaves lidas pelo serviço e pelo compose. Copie para .env (ignorado pelo git).
# Cada chave aqui tem um consumidor: o serviço (via envconfig), o compose ou o Grafana.

# http-server-projeto-korp
APP_PORT=8080
APP_ENV=local
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
READ_HEADER_TIMEOUT=5s

# versão/commit injetados pelo build (ldflags); expostos em build_info
VERSION=dev
COMMIT=none

# limites do runtime Go, alinhados aos limites de cgroup do compose (cpus: "0.5" / mem_limit: 256m).
# GOMEMLIMIT abaixo do mem_limit dá ao GC a chance de coletar antes de o kernel matar por OOM.
# GOMAXPROCS = ceil(cpus): Go < 1.25 não lê a quota do cgroup e assumiria todos os cores do host.
GOMEMLIMIT=200MiB
GOMAXPROCS=1

# Grafana (somente ambiente local; produção usa vault/secret manager)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme
