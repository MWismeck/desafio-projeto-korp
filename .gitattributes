# .gitattributes — normalização de fim de linha (host Windows + scripts bash).
* text=auto eol=lf
*.sh   text eol=lf
*.py   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.conf text eol=lf
*.j2   text eol=lf
*.toml text eol=lf
Makefile text eol=lf
*.ps1  text eol=crlf
*.png  binary
*.jpg  binary
