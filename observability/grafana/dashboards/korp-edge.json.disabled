{
  "id": null,
  "uid": "korp-edge",
  "title": "Korp · Borda e caminho do usuário",
  "description": "O que o USUÁRIO vê: sonda externa (blackbox-exporter) atravessando o NGINX até /projeto-korp, decomposição do tempo por fase da requisição, status HTTP observado de fora e o estado das conexões do NGINX. Responde 'o serviço está bem por dentro mas ruim por fora?'. Criado em 2026-09-06. Runbooks: .agents/runbooks/ALERT_RUNBOOKS.md",
  "tags": ["korp", "edge", "nginx", "blackbox", "ux"],
  "timezone": "utc",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": { "refresh_intervals": ["10s", "30s", "1m", "5m"] },
  "links": [
    { "title": "Runbooks de alerta", "type": "link", "icon": "doc", "url": "https://github.com/MWismeck/desafio-projeto-korp/blob/main/docs/runbooks/ALERT_RUNBOOKS.md", "targetBlank": true },
    { "title": "Dashboards do Korp", "type": "dashboards", "tags": ["korp"], "asDropdown": true, "includeVars": true, "keepTime": true },
    { "title": "RED do serviço", "type": "link", "icon": "bolt", "url": "/d/http-server-projeto-korp?${__url_time_range}", "targetBlank": false },
    { "title": "Saúde de container e host", "type": "link", "icon": "cloud", "url": "/d/korp-container-health?${__url_time_range}", "targetBlank": false }
  ],
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "query": "prometheus",
        "current": { "selected": true, "text": "Prometheus", "value": "prometheus" },
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "type": "query",
        "name": "service",
        "label": "Serviço",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(http_requests_total, service)",
        "definition": "label_values(http_requests_total, service)",
        "current": { "selected": true, "text": "http-server-projeto-korp", "value": "http-server-projeto-korp" },
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "sort": 1,
        "options": []
      },
      {
        "type": "query",
        "name": "instance",
        "label": "Alvo sondado",
        "description": "URL sondada pelo blackbox-exporter (label instance do módulo http_2xx), ex.: http://nginx/projeto-korp.",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(probe_success, instance)",
        "definition": "label_values(probe_success, instance)",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "sort": 1,
        "options": []
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Sonda falhou",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "enable": true,
        "iconColor": "red",
        "expr": "probe_success == 0",
        "step": "1m",
        "titleFormat": "Sonda falhou",
        "textFormat": "{{instance}} não respondeu 2xx à sonda externa",
        "tagKeys": "instance"
      },
      {
        "name": "Restart / deploy do serviço",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "enable": true,
        "iconColor": "orange",
        "expr": "changes(process_start_time_seconds{service=\"$service\"}[$__rate_interval]) > 0",
        "step": "1m",
        "titleFormat": "Restart",
        "textFormat": "{{instance}} reiniciou",
        "tagKeys": "service,instance"
      }
    ]
  },
  "panels": [
    { "type": "row", "id": 100, "title": "Sonda externa — o caminho completo do usuário (blackbox → NGINX → app)", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "panels": [] },
    {
      "type": "stat", "id": 1, "title": "probe_success (agora)",
      "description": "1 = a sonda externa completou a requisição HTTP atravessando o NGINX e recebeu o status esperado. É a disponibilidade do ponto de vista de QUEM USA — pode ser 0 mesmo com up=1 e service_up=1 (proxy quebrado, upstream errado, porta fechada).",
      "gridPos": { "h": 5, "w": 5, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "min(probe_success{instance=~\"$instance\"})", "instant": true, "legendFormat": "probe_success" } ],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "noValue": "blackbox ausente", "mappings": [ { "type": "value", "options": { "0": { "text": "FALHANDO", "color": "red", "index": 0 }, "1": { "text": "OK", "color": "green", "index": 1 } } } ], "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "none", "textMode": "value" },
      "links": [ { "title": "Runbook ServiceUnavailable", "url": "https://github.com/MWismeck/desafio-projeto-korp/blob/main/docs/runbooks/ALERT_RUNBOOKS.md#serviceunavailable", "targetBlank": true } ]
    },
    {
      "type": "stat", "id": 2, "title": "Disponibilidade externa no período",
      "description": "avg_over_time(probe_success[$__range]) — fração do intervalo em que a sonda passou. É a leitura mais honesta de 'o serviço esteve no ar', porque inclui NGINX, rede e DNS da korp-net. Vermelho abaixo de 99,9 %.",
      "gridPos": { "h": 5, "w": 5, "x": 5, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "min(avg_over_time(probe_success{instance=~\"$instance\"}[$__range]))", "instant": true, "legendFormat": "disponibilidade" } ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 2, "min": 0, "max": 1, "noValue": "blackbox ausente", "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 0.995 }, { "color": "green", "value": 0.999 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "value" }
    },
    {
      "type": "timeseries", "id": 3, "title": "Status HTTP observado de fora (probe_http_status_code)",
      "description": "Código que o NGINX devolveu à sonda. 200 é o esperado; 502/504 apontam para o upstream (app fora do ar ou lento demais); 404 indica location/proxy_pass errado no http-server-projeto-korp.conf.",
      "gridPos": { "h": 5, "w": 14, "x": 10, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "probe_http_status_code{instance=~\"$instance\"}", "legendFormat": "{{instance}}" } ],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "min": 0, "noValue": "blackbox ausente", "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "lineWidth": 2, "fillOpacity": 0, "spanNulls": false, "thresholdsStyle": { "mode": "line" } }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 400 }, { "color": "red", "value": 500 } ] } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "id": 4, "title": "Tempo por fase da requisição (probe_http_duration_seconds)",
      "description": "Decomposição empilhada do tempo total da sonda por fase: resolve (DNS), connect (TCP), tls, processing (espera pelo primeiro byte = tempo do app) e transfer. Se 'processing' domina, o problema é o serviço; se 'connect' domina, é rede/NGINX; se 'resolve' domina, é DNS da korp-net.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum by (phase) (probe_http_duration_seconds{instance=~\"$instance\"})", "legendFormat": "{{phase}}" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "max(probe_duration_seconds{instance=~\"$instance\"})", "legendFormat": "total da sonda" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 4, "min": 0, "noValue": "blackbox ausente", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 25, "spanNulls": false, "stacking": { "mode": "normal" }, "thresholdsStyle": { "mode": "line" } }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.3 } ] } }, "overrides": [ { "matcher": { "id": "byName", "options": "total da sonda" }, "properties": [ { "id": "custom.stacking", "value": { "mode": "none" } }, { "id": "custom.fillOpacity", "value": 0 }, { "id": "custom.lineWidth", "value": 2 }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "text" } } ] } ] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "links": [ { "title": "Runbook ServiceHighLatencyBurn", "url": "https://github.com/MWismeck/desafio-projeto-korp/blob/main/docs/runbooks/ALERT_RUNBOOKS.md#servicehighlatencyburn", "targetBlank": true } ]
    },
    {
      "type": "timeseries", "id": 5, "title": "Borda × origem: req/s no NGINX vs no serviço",
      "description": "rate(nginx_http_requests_total) contra sum(rate(http_requests_total)). As duas linhas devem andar coladas. NGINX acima do app = requisições morrendo na borda (4xx/5xx do próprio NGINX, rate limit, upstream indisponível); app acima do NGINX = alguém chama o serviço sem passar pelo proxy.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(rate(nginx_http_requests_total[$__rate_interval]))", "legendFormat": "NGINX (borda)" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(rate(http_requests_total{service=\"$service\"}[$__rate_interval]))", "legendFormat": "serviço (origem)" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2, "min": 0, "noValue": "sem tráfego", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "spanNulls": false } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    { "type": "row", "id": 101, "title": "NGINX — conexões e descarte", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }, "panels": [] },
    {
      "type": "timeseries", "id": 6, "title": "Conexões do NGINX (active / reading / writing / waiting)",
      "description": "Estado das conexões do stub_status. 'waiting' alto com 'writing' baixo é normal (keep-alive ocioso); 'writing' crescendo junto com a latência do app significa que o NGINX está segurando respostas lentas e consumindo worker_connections.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "nginx_connections_active", "legendFormat": "active" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "nginx_connections_reading", "legendFormat": "reading" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "nginx_connections_writing", "legendFormat": "writing" },
        { "refId": "D", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "nginx_connections_waiting", "legendFormat": "waiting" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "min": 0, "noValue": "nginx-exporter ausente", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "spanNulls": false } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries", "id": 7, "title": "Conexões descartadas (accepted − handled)",
      "description": "rate(nginx_connections_accepted) − rate(nginx_connections_handled): conexões aceitas que o NGINX NÃO conseguiu tratar. Em operação normal é exatamente 0 (linha colada no eixo). Qualquer valor > 0 (vermelho) é conexão de usuário descartada por falta de worker_connections/FD — e essas requisições nunca aparecem no dashboard RED do serviço, porque nunca chegaram nele.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "rate(nginx_connections_accepted[$__rate_interval]) - rate(nginx_connections_handled[$__rate_interval])", "legendFormat": "descartadas/s" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "rate(nginx_connections_accepted[$__rate_interval])", "legendFormat": "aceitas/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "cps", "decimals": 3, "min": 0, "noValue": "nginx-exporter ausente", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "spanNulls": false, "thresholdsStyle": { "mode": "line" } }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.001 } ] } }, "overrides": [ { "matcher": { "id": "byName", "options": "aceitas/s" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }, { "id": "custom.fillOpacity", "value": 0 } ] }, { "matcher": { "id": "byName", "options": "descartadas/s" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] } ] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    { "type": "row", "id": 102, "title": "Estado da borda e da coleta", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 }, "panels": [] },
    {
      "type": "timeseries", "id": 8, "title": "Estado dos alvos da borda (up)",
      "description": "up do nginx-exporter, do blackbox-exporter e do próprio serviço. Antes de acreditar que 'a borda está boa', confirme aqui que quem mede a borda está de pé — exporter caído produz painel vazio, não painel verde.",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "up", "legendFormat": "{{job}} @ {{instance}}" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "nginx_up", "legendFormat": "nginx_up (stub_status)" }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "min": 0, "max": 1, "noValue": "sem alvo", "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "lineWidth": 2, "fillOpacity": 20, "spanNulls": false }, "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 0 }, "1": { "text": "UP", "color": "green", "index": 1 } } } ], "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "links": [ { "title": "Runbook TargetDown", "url": "https://github.com/MWismeck/desafio-projeto-korp/blob/main/docs/runbooks/ALERT_RUNBOOKS.md#targetdown", "targetBlank": true } ]
    },
    {
      "type": "timeseries", "id": 9, "title": "Latência: sonda externa vs p95 interno",
      "description": "probe_duration_seconds (fora, atravessando o NGINX) contra o p95 de http_request_duration_seconds (dentro do app). A DIFERENÇA entre as duas linhas é o custo da borda: proxy, rede da korp-net e enfileiramento. Diferença crescente com p95 estável = problema no NGINX, não no serviço.",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "max(probe_duration_seconds{instance=~\"$instance\"})", "legendFormat": "sonda externa (total)" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{service=\"$service\"}[$__rate_interval])))", "legendFormat": "p95 interno" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 4, "min": 0, "noValue": "sem tráfego", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "spanNulls": false, "thresholdsStyle": { "mode": "line" } }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.3 } ] } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    }
  ]
}
